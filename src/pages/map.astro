---
import Base from "../layouts/Base.astro";
import HabitatMap from "../components/HabitatMap.astro";
import { BEARS } from "../data/bears";
---
<Base title="Bear range map">
  <main class="wrap">
    <section class="section">
      <p class="kicker">Map</p>
      <h1>Range sketches and cameras</h1>
      <p class="lede">
        Colored fills are simplified core-range sketches for all eight living bears.
        Buttons fly the camera; click a polygon or pin for the species page.
        Minnesota’s north woods is a dedicated camera on the American black bear page.
      </p>
      <HabitatMap />
      <div class="legend">
        {BEARS.map((b) => (
          <a class="legend-item" href={`/bears/${b.slug}`}>
            <span class="swatch" style={`background:${b.accent}`}></span>
            <span>{b.name}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
