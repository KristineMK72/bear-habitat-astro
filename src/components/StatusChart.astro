---
import { BEARS } from "../data/bears";
const counts: Record<string, number> = {};
for (const b of BEARS) counts[b.conservation.status] = (counts[b.conservation.status] || 0) + 1;
const entries = Object.entries(counts);
---
<div class="panel">
  <p class="kicker">Figure 2</p>
  <h2>IUCN-style status mix</h2>
  <p class="sci">Six of eight living species sit in a threatened category.</p>
  <svg viewBox="0 0 360 160" width="100%" height="160" aria-label="Status counts">
    {entries.map(([label, n], i) => {
      const x = 24 + i * 110;
      const h = n * 18;
      return (
        <g>
          <rect x={x} y={120 - h} width="72" height={h} rx="8" fill="#d4a24c" opacity={0.85 - i * 0.12} />
          <text x={x + 36} y="138" text-anchor="middle" fill="#b7aa93" font-size="11">{label}</text>
          <text x={x + 36} y={112 - h} text-anchor="middle" fill="#f3ead8" font-size="16">{n}</text>
        </g>
      );
    })}
  </svg>
</div>
